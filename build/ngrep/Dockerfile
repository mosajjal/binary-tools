# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds ngrep at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=1.49.0 -t bt/ngrep build/ngrep

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 libpcap-dev pcre2-dev pkgconf
RUN git clone --depth 1 https://github.com/jpr5/ngrep.git /src && cd /src && REF="v${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && test -x configure || autoreconf -fi \
 && ./configure --enable-pcre2 LDFLAGS=-static \
 && make -j$(nproc) \
 && cp ngrep /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/ngrep) && cp /tmp/out/ngrep /out/x64/ngrep \
 && strip "/out/x64/ngrep" || echo 'strip x64 failed (non-ELF?)' \
 && ( upx -q --best --lzma "/out/x64/ngrep" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
