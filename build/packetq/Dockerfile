# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds packetq at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/packetq build/packetq

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 autoconf automake libtool
RUN git clone --depth 1 --branch v${VERSION} https://github.com/DNS-OARC/PacketQ.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && test -x configure || autoreconf -fi \
 && ./configure LDFLAGS=-static \
 && make -j$(nproc) \
 && cp src/packetq /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/packetq) && cp /tmp/out/packetq /out/x64/packetq \
 && strip "/out/x64/packetq" \
 && ( upx -q --best --lzma "/out/x64/packetq" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
