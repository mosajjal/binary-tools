# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds zenith at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/zenith build/zenith

FROM rust:1-alpine AS build
ARG VERSION
RUN apk add --no-cache linux-headers clang clang-dev llvm-dev gcc
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-C target-feature=+crt-static"
ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABIHF_RUSTFLAGS="-C target-feature=+crt-static"
RUN apk add --no-cache git ca-certificates upx musl-dev perl make
RUN git clone --depth 1 --branch ${VERSION} https://github.com/bvaisvil/zenith.git /src
WORKDIR /src
ENV LIBCLANG_PATH=/usr/lib/llvm22/lib
RUN set -ex \
 && cargo build --release --target x86_64-unknown-linux-musl \
 && cp target/x86_64-unknown-linux-musl/release/zenith /tmp/x64_zenith

# --- ARMv7 cross (musl.cc toolchain as linker) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz && rm /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABIHF_LINKER=arm-linux-musleabihf-gcc \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABIHF_AR=arm-linux-musleabihf-ar \
    CC_armv7_unknown_linux_musleabihf=arm-linux-musleabihf-gcc \
    AR_armv7_unknown_linux_musleabihf=arm-linux-musleabihf-ar
RUN rustup target add armv7-unknown-linux-musleabihf
RUN set -ex \
 && cargo build --release --target armv7-unknown-linux-musleabihf \
 && cp target/armv7-unknown-linux-musleabihf/release/zenith /tmp/arm_zenith

RUN set -ex \
 && mkdir -p $(dirname /out/x64/zenith) && cp /tmp/x64_zenith /out/x64/zenith \
 && mkdir -p $(dirname /out/arm/zenith) && cp /tmp/arm_zenith /out/arm/zenith \
 && strip "/out/x64/zenith" \
 && arm-linux-musleabihf-strip "/out/arm/zenith" \
 && ( upx -q --best --lzma "/out/x64/zenith" "/out/arm/zenith" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
