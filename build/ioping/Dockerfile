# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds ioping at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/ioping build/ioping

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2
RUN git clone --depth 1 --branch v${VERSION} https://github.com/koct9i/ioping.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && make -j$(nproc) LDFLAGS=-static \
 && cp ioping /tmp/out/

# --- ARMv7 cross (musl.cc toolchain) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH
RUN set -ex \
 && mkdir -p /tmp/out-arm \
 && make clean || true \
 && make -j$(nproc) CC=arm-linux-musleabihf-gcc LDFLAGS=-static \
 && cp ioping /tmp/out-arm/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/ioping) && cp /tmp/out/ioping /out/x64/ioping \
 && mkdir -p $(dirname /out/arm/ioping) && cp /tmp/out-arm/ioping /out/arm/ioping \
 && strip "/out/x64/ioping" \
 && arm-linux-musleabihf-strip "/out/arm/ioping" \
 && ( upx -q --best --lzma "/out/x64/ioping" "/out/arm/ioping" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
