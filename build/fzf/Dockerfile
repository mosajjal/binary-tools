# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds fzf at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/fzf build/fzf

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/junegunn/fzf.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_fzf .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_fzf .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/fzf) && cp /tmp/x64_fzf /out/x64/fzf \
 && mkdir -p $(dirname /out/arm/fzf) && cp /tmp/arm_fzf /out/arm/fzf \
 && strip "/out/x64/fzf" "/out/arm/fzf" \
 && upx -q --best --lzma "/out/x64/fzf" "/out/arm/fzf" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
