# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds termshark at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/termshark build/termshark

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/gcla/termshark.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_termshark ./cmd/termshark

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_termshark ./cmd/termshark

RUN set -ex \
 && mkdir -p $(dirname /out/x64/termshark) && cp /tmp/x64_termshark /out/x64/termshark \
 && mkdir -p $(dirname /out/arm/termshark) && cp /tmp/arm_termshark /out/arm/termshark \
 && strip "/out/x64/termshark" "/out/arm/termshark" \
 && upx -q --best --lzma "/out/x64/termshark" "/out/arm/termshark" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
