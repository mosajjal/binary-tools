# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds inlets at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/inlets build/inlets

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 https://github.com/the-cc-dev/inlets.git /src
WORKDIR /src
RUN test -f go.mod || go mod init inlets && rm -rf vendor && go mod tidy
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_inlets .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_inlets .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/inlets) && cp /tmp/x64_inlets /out/x64/inlets \
 && mkdir -p $(dirname /out/arm/inlets) && cp /tmp/arm_inlets /out/arm/inlets \
 && test -n "$(ls "/out/x64/inlets" "/out/arm/inlets" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && ( upx -q --best --lzma "/out/x64/inlets" "/out/arm/inlets" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
