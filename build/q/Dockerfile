# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds q at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/q build/q

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/natesales/q.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_q .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_q .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/q) && cp /tmp/x64_q /out/x64/q \
 && mkdir -p $(dirname /out/arm/q) && cp /tmp/arm_q /out/arm/q \
 && ( upx -q --best --lzma "/out/x64/q" "/out/arm/q" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
