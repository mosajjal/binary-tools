# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds ugrep at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/ugrep build/ugrep

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 autoconf automake libtool bash pkgconf
RUN git clone --depth 1 --branch v${VERSION} https://github.com/Genivia/ugrep.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && autoreconf -fi \
 && CONFIG_SHELL=/bin/bash bash ./configure --disable-shared LDFLAGS=-static \
 && make -j$(nproc) ACLOCAL=: AUTOCONF=: AUTOHEADER=: AUTOMAKE=: \
 && cp bin/ugrep /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/ugrep) && cp /tmp/out/ugrep /out/x64/ugrep \
 && strip "/out/x64/ugrep" \
 && ( upx -q --best --lzma "/out/x64/ugrep" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
