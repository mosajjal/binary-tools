# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds curl at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=8.11.1 -t bt/curl build/curl

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 autoconf automake libtool openssl-dev openssl-libs-static zlib-static nghttp2-static nghttp2-dev ca-certificates
RUN git clone --depth 1 --branch curl-${VERSION} https://github.com/curl/curl.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./buildconf && ./configure --disable-shared --enable-static --with-openssl --with-nghttp2 --with-zlib --without-libpsl --without-brotli --without-zstd --without-libidn2 --disable-ldap --disable-ldaps \
 && make -j$(nproc) LDFLAGS=-static \
 && cp src/curl /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/curl) && cp /tmp/out/curl /out/x64/curl \
 && strip "/out/x64/curl" \
 && upx -q --best --lzma "/out/x64/curl" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
