# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds miniserve at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/miniserve build/miniserve

FROM rust:1-alpine AS build
ARG VERSION
RUN apk add --no-cache openssl-libs-static
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-C target-feature=+crt-static"
ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABIHF_RUSTFLAGS="-C target-feature=+crt-static"
RUN apk add --no-cache git ca-certificates upx musl-dev perl make
RUN git clone --depth 1 --branch v${VERSION} https://github.com/svenstaro/miniserve.git /src
WORKDIR /src
ENV OPENSSL_STATIC=1
RUN set -ex \
 && cargo build --release --target x86_64-unknown-linux-musl --features tls \
 && cp target/x86_64-unknown-linux-musl/release/miniserve /tmp/x64_miniserve

# --- ARMv7 cross (musl.cc toolchain as linker) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz && rm /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABIHF_LINKER=arm-linux-musleabihf-gcc \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABIHF_AR=arm-linux-musleabihf-ar \
    CC_armv7_unknown_linux_musleabihf=arm-linux-musleabihf-gcc \
    AR_armv7_unknown_linux_musleabihf=arm-linux-musleabihf-ar
RUN rustup target add armv7-unknown-linux-musleabihf
RUN set -ex \
 && cargo build --release --target armv7-unknown-linux-musleabihf --features tls \
 && cp target/armv7-unknown-linux-musleabihf/release/miniserve /tmp/arm_miniserve

RUN set -ex \
 && mkdir -p $(dirname /out/x64/miniserve) && cp /tmp/x64_miniserve /out/x64/miniserve \
 && mkdir -p $(dirname /out/arm/miniserve) && cp /tmp/arm_miniserve /out/arm/miniserve \
 && strip "/out/x64/miniserve" \
 && arm-linux-musleabihf-strip "/out/arm/miniserve" \
 && ( upx -q --best --lzma "/out/x64/miniserve" "/out/arm/miniserve" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
