# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds vi at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/vi build/vi

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 ncurses-static ncurses-dev
RUN git clone --depth 1 --branch ${VERSION} https://github.com/johnsonjh/OpenVi.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && make -j$(nproc) -f GNUmakefile LDFLAGS=-static || make -j$(nproc) -f GNUmakefile \
 && cp bin/vi /tmp/out/vi 2>/dev/null || cp ovi /tmp/out/vi 2>/dev/null || find . -maxdepth 2 -name vi -path '*bin*' -exec cp {} /tmp/out/vi \;

RUN set -ex \
 && mkdir -p $(dirname /out/x64/vi) && cp /tmp/out/vi /out/x64/vi \
 && strip "/out/x64/vi" \
 && ( upx -q --best --lzma "/out/x64/vi" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
