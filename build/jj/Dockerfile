# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds jj at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/jj build/jj

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/tidwall/jj.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_jj ./cmd/jj

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_jj ./cmd/jj

RUN set -ex \
 && mkdir -p $(dirname /out/x64/jj) && cp /tmp/x64_jj /out/x64/jj \
 && mkdir -p $(dirname /out/arm/jj) && cp /tmp/arm_jj /out/arm/jj \
 && ( upx -q --best --lzma "/out/x64/jj" "/out/arm/jj" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
