# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds htop at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/htop build/htop

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 autoconf automake ncurses-dev ncurses-static
RUN git clone --depth 1 --branch ${VERSION} https://github.com/htop-dev/htop.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && test -x configure || autoreconf -fi \
 && ./configure LDFLAGS=-static LIBS=-lncursesw \
 && make -j$(nproc) \
 && cp htop /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/htop) && cp /tmp/out/htop /out/x64/htop \
 && strip "/out/x64/htop" \
 && ( upx -q --best --lzma "/out/x64/htop" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
