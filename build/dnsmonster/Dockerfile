# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds dnsmonster at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/dnsmonster build/dnsmonster

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=1 GOTOOLCHAIN=auto
RUN apk add --no-cache build-base
RUN apk add --no-cache build-base libpcap-dev flex bison curl
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 https://github.com/FenkoHQ/dnsmonster.git /src && cd /src && REF="v${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w -linkmode external -extldflags=-static -extldflags "-static"" -o /tmp/x64_dnsmonster ./cmd/dnsmonster

# --- ARMv7 cgo cross (musl.cc toolchain as C compiler) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz && rm /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH
RUN set -ex \
 && mkdir -p /pcap-src /opt/arm-libpcap \
 && curl -fsSL --retry 3 https://www.tcpdump.org/release/libpcap-1.10.5.tar.gz | gunzip -c | tar x -C /pcap-src --strip-components=1 \
 && cd /pcap-src && ./configure --host=arm-linux-musleabihf --prefix=/opt/arm-libpcap --disable-shared --without-libnl --disable-dbus --disable-rdma ac_cv_linux_vers=2 && make -j$(nproc) && make install && cd /src

RUN set -ex \
 && CGO_ENABLED="1" CGO_CFLAGS="-I/opt/arm-libpcap/include" CGO_LDFLAGS="-L/opt/arm-libpcap/lib" CC=arm-linux-musleabihf-gcc GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w -linkmode external -extldflags=-static -extldflags "-static"" -o /tmp/arm_dnsmonster ./cmd/dnsmonster

RUN set -ex \
 && mkdir -p $(dirname /out/x64/dnsmonster) && cp /tmp/x64_dnsmonster /out/x64/dnsmonster \
 && mkdir -p $(dirname /out/arm/dnsmonster) && cp /tmp/arm_dnsmonster /out/arm/dnsmonster \
 && test -n "$(ls "/out/x64/dnsmonster" "/out/arm/dnsmonster" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && for f in "/out/x64/dnsmonster" "/out/arm/dnsmonster"; do file "$f" | grep -q ELF || continue; file "$f" | grep -qE "statically linked|static-pie linked" || { echo "ERROR: $f is dynamically linked"; file "$f"; exit 1; }; done \
 && ( upx -q --best --lzma "/out/x64/dnsmonster" "/out/arm/dnsmonster" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
