# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds gron at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/gron build/gron

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/tomnomnom/gron.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_gron .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_gron .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/gron) && cp /tmp/x64_gron /out/x64/gron \
 && mkdir -p $(dirname /out/arm/gron) && cp /tmp/arm_gron /out/arm/gron \
 && ( upx -q --best --lzma "/out/x64/gron" "/out/arm/gron" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
