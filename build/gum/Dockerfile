# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds gum at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/gum build/gum

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/charmbracelet/gum.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_gum .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_gum .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/gum) && cp /tmp/x64_gum /out/x64/gum \
 && mkdir -p $(dirname /out/arm/gum) && cp /tmp/arm_gum /out/arm/gum \
 && ( upx -q --best --lzma "/out/x64/gum" "/out/arm/gum" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
