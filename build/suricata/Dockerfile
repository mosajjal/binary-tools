# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds suricata at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/suricata build/suricata

FROM rust:1-alpine AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 autoconf automake libtool pkgconf pcre-dev pcre-static pcre2-dev yaml-dev yaml-static jansson-dev jansson-static libpcap-dev openssl-libs-static zlib-static
RUN mkdir -p /src && curl -fsSL --retry 3 --retry-delay 2 "https://www.openinfosecfoundation.org/download/suricata-${VERSION}.tar.gz" | gunzip -c | tar x -C /src --strip-components=1
WORKDIR /src
RUN mkdir -p /pcre2-src /opt/pcre2 && curl -fsSL --retry 3 https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.45/pcre2-10.45.tar.gz | gunzip -c | tar x -C /pcre2-src --strip-components=1 && cd /pcre2-src && ./configure --prefix=/opt/pcre2 --disable-shared --enable-static && make -j$(nproc) && make install && cd /src && (cd rust && cargo update -p lexical-core 2>/dev/null || cargo update 2>/dev/null || true)
RUN set -ex \
 && mkdir -p /tmp/out \
 && PKG_CONFIG_PATH=/opt/pcre2/lib/pkgconfig PKG_CONFIG='pkg-config --static' ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var LDFLAGS='-static -no-pie -L/opt/pcre2/lib' CFLAGS='-O2 -static -no-pie' CPPFLAGS='-I/opt/pcre2/include' --disable-python --disable-lua --disable-nfqueue --disable-nflog --disable-gccmarch-native \
 && make -j$(nproc) LDFLAGS='-all-static -L/opt/pcre2/lib' \
 && cp src/suricata /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/suricata) && cp /tmp/out/suricata /out/x64/suricata \
 && for f in "/out/x64/suricata"; do file "$f" | grep -q ELF && strip "$f" || true; done \
 && test -n "$(ls "/out/x64/suricata" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && for f in "/out/x64/suricata"; do file "$f" | grep -q ELF || continue; file "$f" | grep -qE "statically linked|static-pie linked" || { echo "ERROR: $f is dynamically linked"; file "$f"; exit 1; }; done \
 && ( upx -q --best --lzma "/out/x64/suricata" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
