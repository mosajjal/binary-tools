# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds mylg at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/mylg build/mylg

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache libpcap-dev
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 https://github.com/mehrdadrad/mylg.git /src
WORKDIR /src
ENV CGO_ENABLED=1
RUN set -ex \
 && go build -trimpath -ldflags="-s -w -extldflags "-static"" -o /tmp/x64_mylg .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w -extldflags "-static"" -o /tmp/arm_mylg .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/mylg) && cp /tmp/x64_mylg /out/x64/mylg \
 && mkdir -p $(dirname /out/arm/mylg) && cp /tmp/arm_mylg /out/arm/mylg \
 && ( upx -q --best --lzma "/out/x64/mylg" "/out/arm/mylg" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
