# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds mylg at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/mylg build/mylg

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=1 GOTOOLCHAIN=auto
RUN apk add --no-cache build-base
RUN apk add --no-cache libpcap-dev build-base
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 https://github.com/mehrdadrad/mylg.git /src
WORKDIR /src
ENV CGO_ENABLED=1
RUN test -f go.mod || go mod init mylg; go mod tidy
RUN set -ex \
 && go build -trimpath -ldflags="-s -w -linkmode external -extldflags=-static -extldflags "-static"" -o /tmp/x64_mylg .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/mylg) && cp /tmp/x64_mylg /out/x64/mylg \
 && test -n "$(ls "/out/x64/mylg" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && ( upx -q --best --lzma "/out/x64/mylg" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
