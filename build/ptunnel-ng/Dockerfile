# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds ptunnel-ng at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/ptunnel-ng build/ptunnel-ng

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 autoconf automake libtool
RUN git clone --depth 1 --branch v${VERSION} https://github.com/utoni/ptunnel-ng.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && test -x configure || autoreconf -fi \
 && ./configure LDFLAGS=-static \
 && make -j$(nproc) \
 && cp src/ptunnel-ng /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/ptunnel-ng) && cp /tmp/out/ptunnel-ng /out/x64/ptunnel-ng \
 && strip "/out/x64/ptunnel-ng" \
 && ( upx -q --best --lzma "/out/x64/ptunnel-ng" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
