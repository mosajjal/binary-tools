# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds tor at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=0.4.9.11 -t bt/tor build/tor

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 autoconf automake libtool pkgconf libevent-dev libevent-static openssl-dev openssl-libs-static zlib-static zlib-dev xz-dev
RUN git clone --depth 1 --branch tor-${VERSION} https://gitlab.torproject.org/tpo/core/tor.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./autogen.sh \
 && ./configure --disable-systemd --disable-unittests --disable-libscrypt --disable-module-relay --disable-manpage --disable-html-manpage --enable-static --disable-tool-name-checks LDFLAGS='-static' \
 && make -j$(nproc) \
 && cp src/app/tor /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/tor) && cp /tmp/out/tor /out/x64/tor \
 && strip "/out/x64/tor" \
 && ( upx -q --best --lzma "/out/x64/tor" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
