# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds tor at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=0.4.9.11 -t bt/tor build/tor

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 autoconf automake libtool pkgconf libevent-dev libevent-static openssl-dev openssl-libs-static zlib-static zlib-dev xz-dev xz-static zstd-static zstd-dev
RUN git clone --depth 1 https://gitlab.torproject.org/tpo/core/tor.git /src && cd /src && REF="tor-${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./autogen.sh \
 && ./configure --disable-systemd --disable-unittests --disable-libscrypt --disable-module-relay --disable-asciidoc --disable-manpage LDFLAGS=-static \
 && make -j$(nproc) \
 && cp src/app/tor /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/tor) && cp /tmp/out/tor /out/x64/tor \
 && for f in "/out/x64/tor"; do file "$f" | grep -q ELF && strip "$f" || true; done \
 && test -n "$(ls "/out/x64/tor" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && ( upx -q --best --lzma "/out/x64/tor" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
