# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds vim at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/vim build/vim

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 ncurses-static ncurses-dev acl-dev autoconf
RUN git clone --depth 1 --branch v${VERSION} https://github.com/vim/vim.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && cd src && ./configure --with-features=huge --disable-gui --without-x --disable-nls --disable-canberra --enable-multibyte LDFLAGS=-static && make -j$(nproc) && cp vim /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/vim) && cp /tmp/out/vim /out/x64/vim \
 && strip "/out/x64/vim" \
 && ( upx -q --best --lzma "/out/x64/vim" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
