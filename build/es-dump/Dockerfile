# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds es-dump at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/es-dump build/es-dump

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 https://github.com/mosajjal/x.git /src
WORKDIR /src
RUN set -ex \
 && (cd elasticdump && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /tmp/x64_es-dump .) \
 && (cd elasticdump && CGO_ENABLED=0 GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_es-dump .)

RUN set -ex \
 && mkdir -p $(dirname /out/x64/es-dump) && cp /tmp/x64_es-dump /out/x64/es-dump \
 && ( upx -q --best --lzma "/out/x64/es-dump" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
