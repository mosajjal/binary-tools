# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds es-dump at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/es-dump build/es-dump

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 https://github.com/mosajjal/x.git /src
WORKDIR /src
RUN cd elasticdump && go mod init elasticdump && go mod tidy
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_es-dump ./elasticdump

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_es-dump ./elasticdump

RUN set -ex \
 && mkdir -p $(dirname /out/x64/es-dump) && cp /tmp/x64_es-dump /out/x64/es-dump \
 && mkdir -p $(dirname /out/arm/es-dump) && cp /tmp/arm_es-dump /out/arm/es-dump \
 && strip "/out/x64/es-dump" "/out/arm/es-dump" \
 && upx -q --best --lzma "/out/x64/es-dump" "/out/arm/es-dump" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
