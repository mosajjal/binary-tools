# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds singbox at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/singbox build/singbox

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/SagerNet/sing-box.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_singbox ./cmd/sing-box

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_singbox ./cmd/sing-box

RUN set -ex \
 && mkdir -p $(dirname /out/x64/singbox) && cp /tmp/x64_singbox /out/x64/singbox \
 && mkdir -p $(dirname /out/arm/singbox) && cp /tmp/arm_singbox /out/arm/singbox \
 && ( upx -q --best --lzma "/out/x64/singbox" "/out/arm/singbox" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
