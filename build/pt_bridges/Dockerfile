# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds pt_bridges at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=HEAD -t bt/pt_bridges build/pt_bridges

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 https://gitlab.torproject.org/tpo/anti-censorship/pluggable-transports/snowflake.git /src
RUN git clone --depth 1 https://gitlab.torproject.org/tpo/anti-censorship/pluggable-transports/lyrebird.git /src/lyrebird
RUN git clone --depth 1 https://gitlab.torproject.org/tpo/anti-censorship/pluggable-transports/webtunnel.git /src/webtunnel
WORKDIR /src
RUN set -ex \
 && (cd /src && go build -trimpath -ldflags='-s -w' -o /tmp/x64_snowflake ./client) \
 && (cd /src/lyrebird && go build -trimpath -ldflags='-s -w' -o /tmp/x64_lyrebird ./cmd/lyrebird) \
 && (cd /src/webtunnel && go build -trimpath -ldflags='-s -w' -o /tmp/x64_webtunnel_client ./main/client) \
 && (cd /src/webtunnel && go build -trimpath -ldflags='-s -w' -o /tmp/x64_webtunnel_server ./main/server)

RUN set -ex \
 && mkdir -p $(dirname /out/x64/snowflake) && cp /tmp/x64_snowflake /out/x64/snowflake \
 && mkdir -p $(dirname /out/x64/lyrebird) && cp /tmp/x64_lyrebird /out/x64/lyrebird \
 && mkdir -p $(dirname /out/x64/webtunnel_client) && cp /tmp/x64_webtunnel_client /out/x64/webtunnel_client \
 && mkdir -p $(dirname /out/x64/webtunnel_server) && cp /tmp/x64_webtunnel_server /out/x64/webtunnel_server \
 && test -n "$(ls "/out/x64/snowflake" "/out/x64/lyrebird" "/out/x64/webtunnel_client" "/out/x64/webtunnel_server" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && ( upx -q --best --lzma "/out/x64/snowflake" "/out/x64/lyrebird" "/out/x64/webtunnel_client" "/out/x64/webtunnel_server" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
