# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds 3proxy at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/3proxy build/3proxy

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2
RUN git clone --depth 1 https://github.com/3proxy/3proxy.git /src && cd /src && REF="${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && timeout -k 30 600 make -f Makefile.Linux -j$(nproc) CC=gcc LDFLAGS='-static' WITH_PLUGINS=no \
 && cp bin/3proxy /tmp/out/

# --- ARMv7 cross (musl.cc toolchain) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH
RUN set -ex \
 && mkdir -p /tmp/out-arm \
 && make -f Makefile.Linux clean 2>/dev/null; rm -rf bin/*.o bin/3proxy \
 && timeout -k 30 600 make -f Makefile.Linux -j$(nproc) CC=arm-linux-musleabihf-gcc LDFLAGS='-static' WITH_PLUGINS=no \
 && cp bin/3proxy /tmp/out-arm/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/3proxy) && cp /tmp/out/3proxy /out/x64/3proxy \
 && mkdir -p $(dirname /out/arm/3proxy) && cp /tmp/out-arm/3proxy /out/arm/3proxy \
 && for f in "/out/x64/3proxy"; do file "$f" | grep -q ELF && strip "$f" || true; done \
 && for f in "/out/arm/3proxy"; do file "$f" | grep -q ELF && arm-linux-musleabihf-strip "$f" || true; done \
 && test -n "$(ls "/out/x64/3proxy" "/out/arm/3proxy" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && for f in "/out/x64/3proxy" "/out/arm/3proxy"; do file "$f" | grep -q ELF || continue; file "$f" | grep -qE "statically linked|static-pie linked" || { echo "ERROR: $f is dynamically linked"; file "$f"; exit 1; }; done \
 && ( upx -q --best --lzma "/out/x64/3proxy" "/out/arm/3proxy" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
