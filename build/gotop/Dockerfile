# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds gotop at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/gotop build/gotop

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/xxxserxxx/gotop.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_gotop ./cmd/gotop

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_gotop ./cmd/gotop

RUN set -ex \
 && mkdir -p $(dirname /out/x64/gotop) && cp /tmp/x64_gotop /out/x64/gotop \
 && mkdir -p $(dirname /out/arm/gotop) && cp /tmp/arm_gotop /out/arm/gotop \
 && strip "/out/x64/gotop" "/out/arm/gotop" \
 && upx -q --best --lzma "/out/x64/gotop" "/out/arm/gotop" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
