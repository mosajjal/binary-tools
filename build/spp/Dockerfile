# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds spp at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/spp build/spp

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch ${VERSION} https://github.com/esrrhs/spp.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_spp .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_spp .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/spp) && cp /tmp/x64_spp /out/x64/spp \
 && mkdir -p $(dirname /out/arm/spp) && cp /tmp/arm_spp /out/arm/spp \
 && ( upx -q --best --lzma "/out/x64/spp" "/out/arm/spp" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
