# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds xxd at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/xxd build/xxd

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2
RUN git clone --depth 1 https://github.com/vim/vim.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && cc -O2 -static -o /tmp/out/xxd src/xxd/xxd.c

# --- ARMv7 cross (musl.cc toolchain) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH
RUN set -ex \
 && mkdir -p /tmp/out-arm \
 && arm-linux-musleabihf-gcc -O2 -static -o /tmp/out-arm/xxd src/xxd/xxd.c

RUN set -ex \
 && mkdir -p $(dirname /out/x64/xxd) && cp /tmp/out/xxd /out/x64/xxd \
 && mkdir -p $(dirname /out/arm/xxd) && cp /tmp/out-arm/xxd /out/arm/xxd \
 && for f in "/out/x64/xxd"; do file "$f" | grep -q ELF && strip "$f" || true; done \
 && for f in "/out/arm/xxd"; do file "$f" | grep -q ELF && arm-linux-musleabihf-strip "$f" || true; done \
 && test -n "$(ls "/out/x64/xxd" "/out/arm/xxd" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && ( upx -q --best --lzma "/out/x64/xxd" "/out/arm/xxd" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
