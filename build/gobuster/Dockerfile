# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds gobuster at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/gobuster build/gobuster

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/OJ/gobuster.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_gobuster .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_gobuster .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/gobuster) && cp /tmp/x64_gobuster /out/x64/gobuster \
 && mkdir -p $(dirname /out/arm/gobuster) && cp /tmp/arm_gobuster /out/arm/gobuster \
 && strip "/out/x64/gobuster" "/out/arm/gobuster" \
 && upx -q --best --lzma "/out/x64/gobuster" "/out/arm/gobuster" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
