# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds evtx at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/evtx build/evtx

FROM rust:1-alpine AS build
ARG VERSION
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-C target-feature=+crt-static"
ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABIHF_RUSTFLAGS="-C target-feature=+crt-static"
RUN apk add --no-cache git ca-certificates upx musl-dev perl make
RUN git clone --depth 1 https://github.com/omerbenamram/evtx.git /src && cd /src && REF="v${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN set -ex \
 && cargo build --release --target x86_64-unknown-linux-musl --features evtx_dump \
 && cp target/x86_64-unknown-linux-musl/release/evtx_dump /tmp/x64_evtx

RUN set -ex \
 && mkdir -p $(dirname /out/x64/evtx) && cp /tmp/x64_evtx /out/x64/evtx \
 && strip "/out/x64/evtx" || echo 'strip x64 failed (non-ELF?)' \
 && ( upx -q --best --lzma "/out/x64/evtx" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
