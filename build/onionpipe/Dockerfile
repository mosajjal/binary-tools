# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds onionpipe at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/onionpipe build/onionpipe

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/cmars/onionpipe.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_onionpipe .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_onionpipe .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/onionpipe) && cp /tmp/x64_onionpipe /out/x64/onionpipe \
 && mkdir -p $(dirname /out/arm/onionpipe) && cp /tmp/arm_onionpipe /out/arm/onionpipe \
 && ( upx -q --best --lzma "/out/x64/onionpipe" "/out/arm/onionpipe" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
