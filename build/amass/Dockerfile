# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds amass at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/amass build/amass

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/owasp-amass/amass.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_amass ./cmd/amass

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_amass ./cmd/amass

RUN set -ex \
 && mkdir -p $(dirname /out/x64/amass) && cp /tmp/x64_amass /out/x64/amass \
 && mkdir -p $(dirname /out/arm/amass) && cp /tmp/arm_amass /out/arm/amass \
 && strip "/out/x64/amass" "/out/arm/amass" \
 && upx -q --best --lzma "/out/x64/amass" "/out/arm/amass" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
