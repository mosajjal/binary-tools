# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds termsvg at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/termsvg build/termsvg

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/MrMarble/termsvg.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_termsvg ./cmd/termsvg

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_termsvg ./cmd/termsvg

RUN set -ex \
 && mkdir -p $(dirname /out/x64/termsvg) && cp /tmp/x64_termsvg /out/x64/termsvg \
 && mkdir -p $(dirname /out/arm/termsvg) && cp /tmp/arm_termsvg /out/arm/termsvg \
 && ( upx -q --best --lzma "/out/x64/termsvg" "/out/arm/termsvg" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
