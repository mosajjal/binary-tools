# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds dnspot at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/dnspot build/dnspot

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 https://github.com/mosajjal/dnspot.git /src && cd /src && REF="${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_dnspot-agent ./cmd/agent \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_dnspot-server ./cmd/server

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_dnspot-agent ./cmd/agent \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_dnspot-server ./cmd/server

RUN set -ex \
 && mkdir -p $(dirname /out/x64/dnspot-agent) && cp /tmp/x64_dnspot-agent /out/x64/dnspot-agent \
 && mkdir -p $(dirname /out/x64/dnspot-server) && cp /tmp/x64_dnspot-server /out/x64/dnspot-server \
 && mkdir -p $(dirname /out/arm/dnspot-agent) && cp /tmp/arm_dnspot-agent /out/arm/dnspot-agent \
 && mkdir -p $(dirname /out/arm/dnspot-server) && cp /tmp/arm_dnspot-server /out/arm/dnspot-server \
 && test -n "$(ls "/out/x64/dnspot-agent" "/out/x64/dnspot-server" "/out/arm/dnspot-agent" "/out/arm/dnspot-server" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && ( upx -q --best --lzma "/out/x64/dnspot-agent" "/out/x64/dnspot-server" "/out/arm/dnspot-agent" "/out/arm/dnspot-server" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
