# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds sniproxy at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/sniproxy build/sniproxy

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/mosajjal/sniproxy.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_sniproxy ./cmd/sniproxy

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_sniproxy ./cmd/sniproxy

RUN set -ex \
 && mkdir -p $(dirname /out/x64/sniproxy) && cp /tmp/x64_sniproxy /out/x64/sniproxy \
 && mkdir -p $(dirname /out/arm/sniproxy) && cp /tmp/arm_sniproxy /out/arm/sniproxy \
 && strip "/out/x64/sniproxy" "/out/arm/sniproxy" \
 && upx -q --best --lzma "/out/x64/sniproxy" "/out/arm/sniproxy" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
