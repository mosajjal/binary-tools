# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds fq at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/fq build/fq

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/wader/fq.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_fq .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_fq .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/fq) && cp /tmp/x64_fq /out/x64/fq \
 && mkdir -p $(dirname /out/arm/fq) && cp /tmp/arm_fq /out/arm/fq \
 && ( upx -q --best --lzma "/out/x64/fq" "/out/arm/fq" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
