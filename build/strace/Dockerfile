# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds strace at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/strace build/strace

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2
RUN mkdir -p /src && curl -fsSL "https://github.com/strace/strace/releases/download/v${VERSION}/strace-${VERSION}.tar.xz" | unxz -c | tar x -C /src --strip-components=1
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./configure LDFLAGS=-static --enable-mpers=no \
 && make -j$(nproc) \
 && cp src/strace /tmp/out/

# --- ARMv7 cross (musl.cc toolchain) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH
RUN set -ex \
 && mkdir -p /tmp/out-arm \
 && make distclean || true \
 && ./configure --host=arm-linux-musleabihf LDFLAGS=-static --enable-mpers=no \
 && make -j$(nproc) \
 && cp src/strace /tmp/out-arm/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/strace) && cp /tmp/out/strace /out/x64/strace \
 && mkdir -p $(dirname /out/arm/strace) && cp /tmp/out-arm/strace /out/arm/strace \
 && strip "/out/x64/strace" \
 && arm-linux-musleabihf-strip "/out/arm/strace" \
 && ( upx -q --best --lzma "/out/x64/strace" "/out/arm/strace" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
