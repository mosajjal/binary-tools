# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds httptunnel_client at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/httptunnel_client build/httptunnel_client

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2
RUN mkdir -p /src && curl -fsSL --retry 3 --retry-delay 2 "https://ftp.gnu.org/gnu/httptunnel/httptunnel-${VERSION}.tar.gz" | gunzip -c | tar x -C /src --strip-components=1
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./configure LDFLAGS=-static \
 && make -j$(nproc) \
 && cp hts /tmp/out/httptunnel-server && cp htc /tmp/out/httptunnel-client

RUN set -ex \
 && mkdir -p $(dirname /out/x64/httptunnel-client) && cp /tmp/out/httptunnel-client /out/x64/httptunnel-client \
 && mkdir -p $(dirname /out/x64/httptunnel-server) && cp /tmp/out/httptunnel-server /out/x64/httptunnel-server \
 && strip "/out/x64/httptunnel-client" "/out/x64/httptunnel-server" \
 && ( upx -q --best --lzma "/out/x64/httptunnel-client" "/out/x64/httptunnel-server" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
