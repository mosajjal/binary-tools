# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds icmptunnel at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/icmptunnel build/icmptunnel

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2
RUN git clone --depth 1 https://github.com/DhavalKapil/icmptunnel.git /src && cd /src && REF="v${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && make -j$(nproc) LDFLAGS=-static \
 && cp icmptunnel /tmp/out/

# --- ARMv7 cross (musl.cc toolchain) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH
RUN set -ex \
 && mkdir -p /tmp/out-arm \
 && make clean || true \
 && make -j$(nproc) CC=arm-linux-musleabihf-gcc LDFLAGS=-static \
 && cp icmptunnel /tmp/out-arm/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/icmptunnel) && cp /tmp/out/icmptunnel /out/x64/icmptunnel \
 && mkdir -p $(dirname /out/arm/icmptunnel) && cp /tmp/out-arm/icmptunnel /out/arm/icmptunnel \
 && strip "/out/x64/icmptunnel" || echo 'strip x64 failed (non-ELF?)' \
 && arm-linux-musleabihf-strip "/out/arm/icmptunnel" || echo 'strip arm failed (non-ELF?)' \
 && ( upx -q --best --lzma "/out/x64/icmptunnel" "/out/arm/icmptunnel" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
