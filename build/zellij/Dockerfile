# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds zellij at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/zellij build/zellij

FROM rust:1-alpine AS build
ARG VERSION
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-C target-feature=+crt-static"
ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABIHF_RUSTFLAGS="-C target-feature=+crt-static"
RUN apk add --no-cache git ca-certificates upx musl-dev perl make
RUN git clone --depth 1 --branch v${VERSION} https://github.com/zellij-org/zellij.git /src
WORKDIR /src
RUN set -ex \
 && cargo build --release --target x86_64-unknown-linux-musl \
 && cp target/x86_64-unknown-linux-musl/release/zellij /tmp/x64_zellij

RUN set -ex \
 && mkdir -p $(dirname /out/x64/zellij) && cp /tmp/x64_zellij /out/x64/zellij \
 && strip "/out/x64/zellij" \
 && ( upx -q --best --lzma "/out/x64/zellij" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
