# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds tangd at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/tangd build/tangd

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 meson jose-dev http-parser-dev pkgconf
RUN git clone --depth 1 --branch v${VERSION} https://github.com/latchset/tang.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && mkdir -p /tmp/out \
 && meson setup build \
 && meson compile -C build \
 && cp build/src/tangd /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/tangd) && cp /tmp/out/tangd /out/x64/tangd \
 && strip "/out/x64/tangd" \
 && ( upx -q --best --lzma "/out/x64/tangd" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
