# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds wg-go at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/wg-go build/wg-go

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch ${VERSION} https://github.com/WireGuard/wireguard-go.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_wg-go .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_wg-go .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/wg-go) && cp /tmp/x64_wg-go /out/x64/wg-go \
 && mkdir -p $(dirname /out/arm/wg-go) && cp /tmp/arm_wg-go /out/arm/wg-go \
 && strip "/out/x64/wg-go" "/out/arm/wg-go" \
 && upx -q --best --lzma "/out/x64/wg-go" "/out/arm/wg-go" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
