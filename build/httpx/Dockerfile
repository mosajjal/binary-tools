# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds httpx at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/httpx build/httpx

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/projectdiscovery/httpx.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_httpx ./cmd/httpx

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_httpx ./cmd/httpx

RUN set -ex \
 && mkdir -p $(dirname /out/x64/httpx) && cp /tmp/x64_httpx /out/x64/httpx \
 && mkdir -p $(dirname /out/arm/httpx) && cp /tmp/arm_httpx /out/arm/httpx \
 && ( upx -q --best --lzma "/out/x64/httpx" "/out/arm/httpx" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
