# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds openrsync at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=48070e68d73f67d6922b2ffc8c2dee9754e659c6 -t bt/openrsync build/openrsync

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 patch
RUN mkdir -p /src && curl -fsSL --retry 3 --retry-delay 2 "https://github.com/kristapsdz/openrsync/archive/${VERSION}.tar.gz" | gunzip -c | tar x -C /src --strip-components=1
WORKDIR /src
RUN curl -fsSL --retry 3 https://raw.githubusercontent.com/alpinelinux/aports/master/testing/openrsync/10-assert.patch | patch -p1
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./configure PREFIX=/usr LDFLAGS=-static \
 && make -j$(nproc) \
 && cp openrsync /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/openrsync) && cp /tmp/out/openrsync /out/x64/openrsync \
 && for f in "/out/x64/openrsync"; do file "$f" | grep -q ELF && strip "$f" || true; done \
 && test -n "$(ls "/out/x64/openrsync" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && ( upx -q --best --lzma "/out/x64/openrsync" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
