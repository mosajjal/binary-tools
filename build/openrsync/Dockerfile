# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds openrsync at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/openrsync build/openrsync

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 bmake musl-fts-dev
RUN git clone --depth 1 https://github.com/kristapsdz/openrsync.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./configure LDFLAGS=-static \
 && bmake -j$(nproc) \
 && cp openrsync /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/openrsync) && cp /tmp/out/openrsync /out/x64/openrsync \
 && strip "/out/x64/openrsync" \
 && ( upx -q --best --lzma "/out/x64/openrsync" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
