# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds lnav at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/lnav build/lnav

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 cmake autoconf automake libtool ncurses-static sqlite-static sqlite-dev zlib-static curl-dev openssl-libs-static
RUN git clone --depth 1 --branch v${VERSION} https://github.com/tstack/lnav.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./autogen.sh && ./configure LDFLAGS=-static \
 && make -j$(nproc) \
 && cp src/lnav /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/lnav) && cp /tmp/out/lnav /out/x64/lnav \
 && strip "/out/x64/lnav" \
 && ( upx -q --best --lzma "/out/x64/lnav" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
