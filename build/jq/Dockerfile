# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds jq at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=1.7.1 -t bt/jq build/jq

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2
RUN mkdir -p /src && curl -fsSL --retry 3 --retry-delay 2 "https://github.com/jqlang/jq/releases/download/jq-${VERSION}/jq-${VERSION}.tar.gz" | gunzip -c | tar x -C /src --strip-components=1
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./configure --without-oniguruma --disable-shared \
 && make -j$(nproc) LC_ALL=C LDFLAGS=-all-static \
 && cp jq /tmp/out/

# --- ARMv7 cross (musl.cc toolchain) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH
RUN set -ex \
 && mkdir -p /tmp/out-arm \
 && mkdir -p /src-arm && curl -fsSL "https://github.com/jqlang/jq/releases/download/jq-${VERSION}/jq-${VERSION}.tar.gz" | gunzip -c | tar x -C /src-arm --strip-components=1 \
 && cd /src-arm && ./configure --host=arm-linux-musleabihf --without-oniguruma --disable-shared \
 && make -j$(nproc) LC_ALL=C LDFLAGS=-all-static \
 && cp jq /tmp/out-arm/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/jq) && cp /tmp/out/jq /out/x64/jq \
 && mkdir -p $(dirname /out/arm/jq) && cp /tmp/out-arm/jq /out/arm/jq \
 && for f in "/out/x64/jq"; do file "$f" | grep -q ELF && strip "$f" || true; done \
 && for f in "/out/arm/jq"; do file "$f" | grep -q ELF && arm-linux-musleabihf-strip "$f" || true; done \
 && test -n "$(ls "/out/x64/jq" "/out/arm/jq" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && for f in "/out/x64/jq" "/out/arm/jq"; do file "$f" | grep -q ELF || continue; file "$f" | grep -qE "statically linked|static-pie linked" || { echo "ERROR: $f is dynamically linked"; file "$f"; exit 1; }; done \
 && ( upx -q --best --lzma "/out/x64/jq" "/out/arm/jq" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
