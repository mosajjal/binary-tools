# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds fish at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/fish build/fish

FROM rust:1-alpine AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 cmake ninja pcre2-dev ncurses-dev
RUN git clone --depth 1 https://github.com/fish-shell/fish-shell.git /src && cd /src && REF="${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_EXE_LINKER_FLAGS=-static \
 && cmake --build build -j$(nproc) \
 && cp build/fish /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/fish) && cp /tmp/out/fish /out/x64/fish \
 && strip "/out/x64/fish" \
 && ( upx -q --best --lzma "/out/x64/fish" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
