# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds pdns at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/pdns build/pdns

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 autoconf automake openssl-dev openssl-libs-static libpcap-dev zlib-static
RUN git clone --depth 1 --branch ${VERSION} https://github.com/gamelinux/passivedns.git /src
WORKDIR /src
RUN mkdir -p /ldns-src /opt/ldns && curl -fsSL --retry 3 https://www.nlnetlabs.nl/downloads/ldns/ldns-1.8.3.tar.gz | gunzip -c | tar x -C /ldns-src --strip-components=1
RUN set -ex \
 && mkdir -p /tmp/out \
 && cd /ldns-src && ./configure --prefix=/opt/ldns --disable-shared --with-ssl=/usr && make -j$(nproc) LIBS='-lcrypto' && make install && cd /src \
 && autoreconf -fi \
 && ./configure LDFLAGS='-static -L/opt/ldns/lib' CPPFLAGS='-I/opt/ldns/include' LIBS='-lldns -lssl -lcrypto -lz' \
 && make -j$(nproc) \
 && cp src/passivedns /tmp/out/pdns

RUN set -ex \
 && mkdir -p $(dirname /out/x64/pdns) && cp /tmp/out/pdns /out/x64/pdns \
 && strip "/out/x64/pdns" \
 && ( upx -q --best --lzma "/out/x64/pdns" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
