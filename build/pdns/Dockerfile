# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds pdns at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/pdns build/pdns

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 autoconf automake ldns-dev openssl-dev openssl-libs-static libpcap-dev zlib-static
RUN git clone --depth 1 --branch ${VERSION} https://github.com/gamelinux/passivedns.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && test -x configure || autoreconf -fi \
 && ./configure LDFLAGS=-static LIBS='-lldns -lssl -lcrypto -lz -lpcap' \
 && make -j$(nproc) \
 && cp src/passivedns /tmp/out/pdns

RUN set -ex \
 && mkdir -p $(dirname /out/x64/pdns) && cp /tmp/out/pdns /out/x64/pdns \
 && strip "/out/x64/pdns" \
 && ( upx -q --best --lzma "/out/x64/pdns" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
