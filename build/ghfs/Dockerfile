# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds ghfs at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/ghfs build/ghfs

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/mjpclab/go-http-file-server.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_ghfs .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_ghfs .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/ghfs) && cp /tmp/x64_ghfs /out/x64/ghfs \
 && mkdir -p $(dirname /out/arm/ghfs) && cp /tmp/arm_ghfs /out/arm/ghfs \
 && strip "/out/x64/ghfs" "/out/arm/ghfs" \
 && upx -q --best --lzma "/out/x64/ghfs" "/out/arm/ghfs" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
