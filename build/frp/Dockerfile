# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds frp at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/frp build/frp

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/fatedier/frp.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_frpc ./cmd/frpc \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_frps ./cmd/frps

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_frpc ./cmd/frpc \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_frps ./cmd/frps

RUN set -ex \
 && mkdir -p $(dirname /out/x64/frpc) && cp /tmp/x64_frpc /out/x64/frpc \
 && mkdir -p $(dirname /out/x64/frps) && cp /tmp/x64_frps /out/x64/frps \
 && mkdir -p $(dirname /out/arm/frpc) && cp /tmp/arm_frpc /out/arm/frpc \
 && mkdir -p $(dirname /out/arm/frps) && cp /tmp/arm_frps /out/arm/frps \
 && strip "/out/x64/frpc" "/out/x64/frps" "/out/arm/frpc" "/out/arm/frps" \
 && upx -q --best --lzma "/out/x64/frpc" "/out/x64/frps" "/out/arm/frpc" "/out/arm/frps" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
