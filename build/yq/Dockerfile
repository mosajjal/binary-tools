# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds yq at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/yq build/yq

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/mikefarah/yq.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_yq .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_yq .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/yq) && cp /tmp/x64_yq /out/x64/yq \
 && mkdir -p $(dirname /out/arm/yq) && cp /tmp/arm_yq /out/arm/yq \
 && ( upx -q --best --lzma "/out/x64/yq" "/out/arm/yq" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
