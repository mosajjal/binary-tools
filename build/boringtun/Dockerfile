# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds boringtun at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/boringtun build/boringtun

FROM rust:1.70-alpine AS build
ARG VERSION
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-C target-feature=+crt-static"
ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABIHF_RUSTFLAGS="-C target-feature=+crt-static"
RUN apk add --no-cache git ca-certificates upx musl-dev perl make
RUN git clone --depth 1 --branch boringtun-${VERSION} https://github.com/cloudflare/boringtun.git /src
WORKDIR /src
RUN set -ex \
 && cargo build --release --target x86_64-unknown-linux-musl \
 && cp target/x86_64-unknown-linux-musl/release/boringtun-cli /tmp/x64_boringtun \
 && cp target/x86_64-unknown-linux-musl/release/boringtun-cli /tmp/x64_wg-user

# --- ARMv7 cross (musl.cc toolchain as linker) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz && rm /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABIHF_LINKER=arm-linux-musleabihf-gcc \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABIHF_AR=arm-linux-musleabihf-ar \
    CC_armv7_unknown_linux_musleabihf=arm-linux-musleabihf-gcc \
    AR_armv7_unknown_linux_musleabihf=arm-linux-musleabihf-ar
RUN rustup target add armv7-unknown-linux-musleabihf
RUN set -ex \
 && cargo build --release --target armv7-unknown-linux-musleabihf \
 && cp target/armv7-unknown-linux-musleabihf/release/boringtun-cli /tmp/arm_boringtun \
 && cp target/armv7-unknown-linux-musleabihf/release/boringtun-cli /tmp/arm_wg-user

RUN set -ex \
 && mkdir -p $(dirname /out/x64/boringtun) && cp /tmp/x64_boringtun /out/x64/boringtun \
 && mkdir -p $(dirname /out/x64/wg-user) && cp /tmp/x64_wg-user /out/x64/wg-user \
 && mkdir -p $(dirname /out/arm/boringtun) && cp /tmp/arm_boringtun /out/arm/boringtun \
 && mkdir -p $(dirname /out/arm/wg-user) && cp /tmp/arm_wg-user /out/arm/wg-user \
 && strip "/out/x64/boringtun" "/out/x64/wg-user" \
 && arm-linux-musleabihf-strip "/out/arm/boringtun" "/out/arm/wg-user" \
 && ( upx -q --best --lzma "/out/x64/boringtun" "/out/x64/wg-user" "/out/arm/boringtun" "/out/arm/wg-user" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
