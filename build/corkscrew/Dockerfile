# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds corkscrew at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/corkscrew build/corkscrew

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 autoconf automake
RUN git clone --depth 1 https://github.com/bryanpkc/corkscrew.git /src && cd /src && REF="v${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && test -x configure || autoreconf -fi \
 && ./configure --host=$(gcc -dumpmachine) LDFLAGS=-static \
 && make -j$(nproc) \
 && cp corkscrew /tmp/out/

# --- ARMv7 cross (musl.cc toolchain) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH
RUN set -ex \
 && mkdir -p /tmp/out-arm \
 && make distclean || true \
 && ./configure --host=arm-linux-musleabihf LDFLAGS=-static \
 && make -j$(nproc) \
 && cp corkscrew /tmp/out-arm/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/corkscrew) && cp /tmp/out/corkscrew /out/x64/corkscrew \
 && mkdir -p $(dirname /out/arm/corkscrew) && cp /tmp/out-arm/corkscrew /out/arm/corkscrew \
 && for f in "/out/x64/corkscrew"; do file "$f" | grep -q ELF && strip "$f" || true; done \
 && for f in "/out/arm/corkscrew"; do file "$f" | grep -q ELF && arm-linux-musleabihf-strip "$f" || true; done \
 && test -n "$(ls "/out/x64/corkscrew" "/out/arm/corkscrew" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && ( upx -q --best --lzma "/out/x64/corkscrew" "/out/arm/corkscrew" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
