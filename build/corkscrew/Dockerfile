# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds corkscrew at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/corkscrew build/corkscrew

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 autoconf automake
RUN git clone --depth 1 --branch ${VERSION} https://github.com/bryanpkc/corkscrew.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && test -x configure || autoreconf -fi \
 && ./configure --host=$(gcc -dumpmachine) LDFLAGS=-static \
 && make -j$(nproc) \
 && cp corkscrew /tmp/out/

# --- ARMv7 cross (musl.cc toolchain) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH
RUN set -ex \
 && mkdir -p /tmp/out-arm \
 && make distclean || true \
 && ./configure --host=arm-linux-musleabihf LDFLAGS=-static \
 && make -j$(nproc) \
 && cp corkscrew /tmp/out-arm/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/corkscrew) && cp /tmp/out/corkscrew /out/x64/corkscrew \
 && mkdir -p $(dirname /out/arm/corkscrew) && cp /tmp/out-arm/corkscrew /out/arm/corkscrew \
 && strip "/out/x64/corkscrew" "/out/arm/corkscrew" \
 && upx -q --best --lzma "/out/x64/corkscrew" "/out/arm/corkscrew" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
