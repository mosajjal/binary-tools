# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds lazygit at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/lazygit build/lazygit

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/jesseduffield/lazygit.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_lazygit .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_lazygit .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/lazygit) && cp /tmp/x64_lazygit /out/x64/lazygit \
 && mkdir -p $(dirname /out/arm/lazygit) && cp /tmp/arm_lazygit /out/arm/lazygit \
 && ( upx -q --best --lzma "/out/x64/lazygit" "/out/arm/lazygit" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
