# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds dnstrace at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/dnstrace build/dnstrace

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/rs/dnstrace.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_dnstrace .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_dnstrace .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/dnstrace) && cp /tmp/x64_dnstrace /out/x64/dnstrace \
 && mkdir -p $(dirname /out/arm/dnstrace) && cp /tmp/arm_dnstrace /out/arm/dnstrace \
 && strip "/out/x64/dnstrace" "/out/arm/dnstrace" \
 && upx -q --best --lzma "/out/x64/dnstrace" "/out/arm/dnstrace" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
