# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds dnstrace at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/dnstrace build/dnstrace

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 https://github.com/rs/dnstrace.git /src && cd /src && REF="v${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN go mod init dnstrace && go mod tidy
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_dnstrace .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_dnstrace .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/dnstrace) && cp /tmp/x64_dnstrace /out/x64/dnstrace \
 && mkdir -p $(dirname /out/arm/dnstrace) && cp /tmp/arm_dnstrace /out/arm/dnstrace \
 && ( upx -q --best --lzma "/out/x64/dnstrace" "/out/arm/dnstrace" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
