# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds zmap at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/zmap build/zmap

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 cmake gengetopt flex byacc json-c-dev libunistring-dev libunistring-static libpcap-dev judy-dev gmp-dev go pkgconf
RUN git clone --depth 1 https://github.com/zmap/zmap.git /src && cd /src && REF="v${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_EXE_LINKER_FLAGS=-static -DWITH_DEMOS=OFF -DWITH_WERROR=OFF \
 && cmake --build build -j$(nproc) \
 && cp build/src/zmap /tmp/out/ \
 && cp build/src/ztee /tmp/out/ \
 && GOBIN=/tmp/out GOTOOLCHAIN=auto go install github.com/zmap/zgrab2/cmd/zgrab2@latest

RUN set -ex \
 && mkdir -p $(dirname /out/x64/zmap) && cp /tmp/out/zmap /out/x64/zmap \
 && mkdir -p $(dirname /out/x64/ztee) && cp /tmp/out/ztee /out/x64/ztee \
 && mkdir -p $(dirname /out/x64/zgrab2) && cp /tmp/out/zgrab2 /out/x64/zgrab2 \
 && for f in "/out/x64/zmap" "/out/x64/ztee" "/out/x64/zgrab2"; do file "$f" | grep -q ELF && strip "$f" || true; done \
 && test -n "$(ls "/out/x64/zmap" "/out/x64/ztee" "/out/x64/zgrab2" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && ( upx -q --best --lzma "/out/x64/zmap" "/out/x64/ztee" "/out/x64/zgrab2" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
