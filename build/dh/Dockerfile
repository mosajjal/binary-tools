# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds dh at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/dh build/dh

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2
RUN git clone --depth 1 https://github.com/ryanmjacobs/darkhttpd.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && cc -O2 -static -o /tmp/out/dh darkhttpd.c

# --- ARMv7 cross (musl.cc toolchain) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH
RUN set -ex \
 && mkdir -p /tmp/out-arm \
 && arm-linux-musleabihf-gcc -O2 -static -o /tmp/out-arm/dh darkhttpd.c

RUN set -ex \
 && mkdir -p $(dirname /out/x64/dh) && cp /tmp/out/dh /out/x64/dh \
 && mkdir -p $(dirname /out/arm/dh) && cp /tmp/out-arm/dh /out/arm/dh \
 && strip "/out/x64/dh" "/out/arm/dh" \
 && upx -q --best --lzma "/out/x64/dh" "/out/arm/dh" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
