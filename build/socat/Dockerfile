# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds socat at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/socat build/socat

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 openssl-dev openssl-libs-static readline-static readline-dev ncurses-static zlib-static
RUN mkdir -p /src && curl -fsSL --retry 3 --retry-delay 2 "http://www.dest-unreach.org/socat/download/socat-${VERSION}.tar.gz" | gunzip -c | tar x -C /src --strip-components=1
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./configure LDFLAGS='-static -lssl -lcrypto' \
 && make -j$(nproc) \
 && cp socat /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/socat) && cp /tmp/out/socat /out/x64/socat \
 && strip "/out/x64/socat" || echo 'strip x64 failed (non-ELF?)' \
 && ( upx -q --best --lzma "/out/x64/socat" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
