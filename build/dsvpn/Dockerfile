# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds dsvpn at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/dsvpn build/dsvpn

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2
RUN git clone --depth 1 https://github.com/jedisct1/dsvpn.git /src && cd /src && REF="${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && make CC=gcc LDFLAGS=-static -j$(nproc) \
 && cp dsvpn /tmp/out/

# --- ARMv7 cross (musl.cc toolchain) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH
RUN set -ex \
 && mkdir -p /tmp/out-arm \
 && make clean || true \
 && sed -i '/^\tstrip /d' Makefile \
 && make CC=arm-linux-musleabihf-gcc CFLAGS='-O2' LDFLAGS=-static -j$(nproc) \
 && cp dsvpn /tmp/out-arm/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/dsvpn) && cp /tmp/out/dsvpn /out/x64/dsvpn \
 && mkdir -p $(dirname /out/arm/dsvpn) && cp /tmp/out-arm/dsvpn /out/arm/dsvpn \
 && strip "/out/x64/dsvpn" \
 && arm-linux-musleabihf-strip "/out/arm/dsvpn" \
 && ( upx -q --best --lzma "/out/x64/dsvpn" "/out/arm/dsvpn" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
