# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds bed at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/bed build/bed

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/itchyny/bed.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_bed ./cmd/bed

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_bed ./cmd/bed

RUN set -ex \
 && mkdir -p $(dirname /out/x64/bed) && cp /tmp/x64_bed /out/x64/bed \
 && mkdir -p $(dirname /out/arm/bed) && cp /tmp/arm_bed /out/arm/bed \
 && strip "/out/x64/bed" "/out/arm/bed" \
 && upx -q --best --lzma "/out/x64/bed" "/out/arm/bed" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
