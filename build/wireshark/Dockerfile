# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds wireshark at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/wireshark build/wireshark

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 cmake ninja perl glib-dev glib-static libgcrypt-dev libgcrypt-static c-ares-dev libpcap-dev pcre2-dev zlib-static speexdsp-dev
RUN mkdir -p /src && curl -fsSL "https://www.wireshark.org/download/src/wireshark-${VERSION}.tar.xz" | unxz -c | tar x -C /src --strip-components=1
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && cmake -B build -G Ninja -DBUILD_wireshark=OFF -DBUILD_qtapps=OFF -DENABLE_PCAP=ON -DCMAKE_BUILD_TYPE=Release -DCMAKE_EXE_LINKER_FLAGS=-static \
 && cmake --build build -j$(nproc) \
 && for f in tshark dumpcap editcap mergecap capinfos captype rawshark text2pcap randpkt reordercap sharkd dftest; do cp build/run/$f /tmp/out/ 2>/dev/null || echo missing-$f; done; ls /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/tshark) && cp /tmp/out/tshark /out/x64/tshark \
 && mkdir -p $(dirname /out/x64/dumpcap) && cp /tmp/out/dumpcap /out/x64/dumpcap \
 && mkdir -p $(dirname /out/x64/editcap) && cp /tmp/out/editcap /out/x64/editcap \
 && mkdir -p $(dirname /out/x64/mergecap) && cp /tmp/out/mergecap /out/x64/mergecap \
 && mkdir -p $(dirname /out/x64/capinfos) && cp /tmp/out/capinfos /out/x64/capinfos \
 && mkdir -p $(dirname /out/x64/captype) && cp /tmp/out/captype /out/x64/captype \
 && mkdir -p $(dirname /out/x64/rawshark) && cp /tmp/out/rawshark /out/x64/rawshark \
 && mkdir -p $(dirname /out/x64/text2pcap) && cp /tmp/out/text2pcap /out/x64/text2pcap \
 && mkdir -p $(dirname /out/x64/randpkt) && cp /tmp/out/randpkt /out/x64/randpkt \
 && mkdir -p $(dirname /out/x64/reordercap) && cp /tmp/out/reordercap /out/x64/reordercap \
 && mkdir -p $(dirname /out/x64/sharkd) && cp /tmp/out/sharkd /out/x64/sharkd \
 && mkdir -p $(dirname /out/x64/dftest) && cp /tmp/out/dftest /out/x64/dftest \
 && mkdir -p $(dirname /out/x64/tfshark) && cp /tmp/out/tfshark /out/x64/tfshark \
 && strip "/out/x64/tshark" "/out/x64/dumpcap" "/out/x64/editcap" "/out/x64/mergecap" "/out/x64/capinfos" "/out/x64/captype" "/out/x64/rawshark" "/out/x64/text2pcap" "/out/x64/randpkt" "/out/x64/reordercap" "/out/x64/sharkd" "/out/x64/dftest" "/out/x64/tfshark" \
 && ( upx -q --best --lzma "/out/x64/tshark" "/out/x64/dumpcap" "/out/x64/editcap" "/out/x64/mergecap" "/out/x64/capinfos" "/out/x64/captype" "/out/x64/rawshark" "/out/x64/text2pcap" "/out/x64/randpkt" "/out/x64/reordercap" "/out/x64/sharkd" "/out/x64/dftest" "/out/x64/tfshark" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
