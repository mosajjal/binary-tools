# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds atop at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/atop build/atop

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 ncurses-static ncurses-dev zlib-static
RUN git clone --depth 1 --branch v${VERSION} https://github.com/Atoptool/atop.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && make -j$(nproc) LDFLAGS=-static \
 && cp atop /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/atop) && cp /tmp/out/atop /out/x64/atop \
 && strip "/out/x64/atop" \
 && ( upx -q --best --lzma "/out/x64/atop" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
