# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds massren at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/massren build/massren

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/laurent22/massren.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_massren .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_massren .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/massren) && cp /tmp/x64_massren /out/x64/massren \
 && mkdir -p $(dirname /out/arm/massren) && cp /tmp/arm_massren /out/arm/massren \
 && ( upx -q --best --lzma "/out/x64/massren" "/out/arm/massren" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
