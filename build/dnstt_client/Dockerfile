# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds dnstt_client at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=1.20241021 -t bt/dnstt_client build/dnstt_client

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --branch v${VERSION} https://www.bamsoftware.com/git/dnstt.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_dnstt_client ./dnstt-client \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_dnstt_server ./dnstt-server

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_dnstt_client ./dnstt-client \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_dnstt_server ./dnstt-server

RUN set -ex \
 && mkdir -p $(dirname /out/x64/dnstt_client) && cp /tmp/x64_dnstt_client /out/x64/dnstt_client \
 && mkdir -p $(dirname /out/x64/dnstt_server) && cp /tmp/x64_dnstt_server /out/x64/dnstt_server \
 && mkdir -p $(dirname /out/arm/dnstt_client) && cp /tmp/arm_dnstt_client /out/arm/dnstt_client \
 && mkdir -p $(dirname /out/arm/dnstt_server) && cp /tmp/arm_dnstt_server /out/arm/dnstt_server \
 && ( upx -q --best --lzma "/out/x64/dnstt_client" "/out/x64/dnstt_server" "/out/arm/dnstt_client" "/out/arm/dnstt_server" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
