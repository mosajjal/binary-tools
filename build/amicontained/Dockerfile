# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds amicontained at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/amicontained build/amicontained

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch ${VERSION} https://github.com/genuinetools/amicontained.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_amicontained .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_amicontained .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/amicontained) && cp /tmp/x64_amicontained /out/x64/amicontained \
 && mkdir -p $(dirname /out/arm/amicontained) && cp /tmp/arm_amicontained /out/arm/amicontained \
 && ( upx -q --best --lzma "/out/x64/amicontained" "/out/arm/amicontained" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
