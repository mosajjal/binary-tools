# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds memcd-util at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/memcd-util build/memcd-util

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/me-io/memcached-util.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_memcd-util ./cmd/util

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_memcd-util ./cmd/util

RUN set -ex \
 && mkdir -p $(dirname /out/x64/memcd-util) && cp /tmp/x64_memcd-util /out/x64/memcd-util \
 && mkdir -p $(dirname /out/arm/memcd-util) && cp /tmp/arm_memcd-util /out/arm/memcd-util \
 && ( upx -q --best --lzma "/out/x64/memcd-util" "/out/arm/memcd-util" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
