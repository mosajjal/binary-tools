# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds nano at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/nano build/nano

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 ncurses-static ncurses-dev file-dev
RUN mkdir -p /src && curl -fsSL "https://www.nano-editor.org/dist/v${VERSION%%.*}/nano-${VERSION}.tar.xz" | unxz -c | tar x -C /src --strip-components=1
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./configure LDFLAGS=-static \
 && make -j$(nproc) \
 && cp src/nano /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/nano) && cp /tmp/out/nano /out/x64/nano \
 && strip "/out/x64/nano" \
 && upx -q --best --lzma "/out/x64/nano" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
