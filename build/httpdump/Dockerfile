# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds httpdump at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/httpdump build/httpdump

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache build-base libpcap-dev libpcap
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 https://github.com/hsiafan/httpdump.git /src
WORKDIR /src
ENV CGO_ENABLED="1"
RUN set -ex \
 && go build -trimpath -ldflags="-s -w -extldflags "-static"" -o /tmp/x64_httpdump .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/httpdump) && cp /tmp/x64_httpdump /out/x64/httpdump \
 && test -n "$(ls "/out/x64/httpdump" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && for f in "/out/x64/httpdump"; do file "$f" | grep -q ELF || continue; file "$f" | grep -qE "statically linked|static-pie linked" || { echo "ERROR: $f is dynamically linked"; file "$f"; exit 1; }; done \
 && ( upx -q --best --lzma "/out/x64/httpdump" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
