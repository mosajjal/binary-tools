# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds httpdump at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/httpdump build/httpdump

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 https://github.com/hsiafan/httpdump.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_httpdump .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_httpdump .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/httpdump) && cp /tmp/x64_httpdump /out/x64/httpdump \
 && mkdir -p $(dirname /out/arm/httpdump) && cp /tmp/arm_httpdump /out/arm/httpdump \
 && test -n "$(ls "/out/x64/httpdump" "/out/arm/httpdump" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && ( upx -q --best --lzma "/out/x64/httpdump" "/out/arm/httpdump" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
