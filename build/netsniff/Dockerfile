# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds netsniff at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/netsniff build/netsniff

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 autoconf automake libtool libnl3 libnl3-dev libnl3-static libpcap-dev ncurses-dev ncurses-static libnetfilter_queue-dev bash
RUN git clone --depth 1 --branch v${VERSION} https://github.com/netsniff-ng/netsniff-ng.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && chmod +x configure && ./configure \
 && make -j$(nproc) LDFLAGS=-static \
 && cp netsniff-ng ifpps /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/netsniff-ng) && cp /tmp/out/netsniff-ng /out/x64/netsniff-ng \
 && mkdir -p $(dirname /out/x64/ifpps) && cp /tmp/out/ifpps /out/x64/ifpps \
 && strip "/out/x64/netsniff-ng" "/out/x64/ifpps" \
 && ( upx -q --best --lzma "/out/x64/netsniff-ng" "/out/x64/ifpps" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
