# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds tcpdump at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/tcpdump build/tcpdump

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 flex byacc
RUN mkdir -p /src && curl -fsSL --retry 3 --retry-delay 2 "https://www.tcpdump.org/release/tcpdump-${VERSION}.tar.gz" | gunzip -c | tar x -C /src --strip-components=1
WORKDIR /src
RUN mkdir -p /libpcap-src /opt/libpcap && curl -fsSL https://www.tcpdump.org/release/libpcap-1.10.5.tar.gz | tar xz -C /libpcap-src --strip-components=1
RUN set -ex \
 && mkdir -p /tmp/out \
 && cd /libpcap-src && ./configure --prefix=/opt/libpcap --enable-dbus=no --without-libnl && make -j$(nproc) && make install && cd /src \
 && PATH=/opt/libpcap/bin:$PATH ./configure CFLAGS='-I/opt/libpcap/include' LDFLAGS='-static -L/opt/libpcap/lib' \
 && make -j$(nproc) \
 && cp tcpdump /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/tcpdump) && cp /tmp/out/tcpdump /out/x64/tcpdump \
 && strip "/out/x64/tcpdump" || echo 'strip x64 failed (non-ELF?)' \
 && ( upx -q --best --lzma "/out/x64/tcpdump" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
