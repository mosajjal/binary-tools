# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds dropbear at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/dropbear build/dropbear

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 autoconf automake zlib-static zlib-dev
RUN git clone --depth 1 --branch DROPBEAR_${VERSION} https://github.com/mkj/dropbear.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./configure LDFLAGS=-static --disable-zlib \
 && make -j$(nproc) PROGRAMS='dropbear dbclient dropbearconvert dropbearkey scp' \
 && cp dropbear dbclient dropbearconvert dropbearkey scp /tmp/out/

# --- ARMv7 cross (musl.cc toolchain) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH
RUN set -ex \
 && mkdir -p /tmp/out-arm \
 && make clean || true \
 && ./configure --host=arm-linux-musleabihf LDFLAGS=-static --disable-zlib \
 && make -j$(nproc) PROGRAMS='dropbear dbclient dropbearconvert dropbearkey scp' \
 && mkdir -p /tmp/out-arm && cp dropbear dbclient dropbearconvert dropbearkey scp /tmp/out-arm/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/dropbear) && cp /tmp/out/dropbear /out/x64/dropbear \
 && mkdir -p $(dirname /out/x64/dbclient) && cp /tmp/out/dbclient /out/x64/dbclient \
 && mkdir -p $(dirname /out/x64/dropbearconvert) && cp /tmp/out/dropbearconvert /out/x64/dropbearconvert \
 && mkdir -p $(dirname /out/x64/dropbearkey) && cp /tmp/out/dropbearkey /out/x64/dropbearkey \
 && mkdir -p $(dirname /out/x64/scp) && cp /tmp/out/scp /out/x64/scp \
 && mkdir -p $(dirname /out/arm/dropbear) && cp /tmp/out-arm/dropbear /out/arm/dropbear \
 && mkdir -p $(dirname /out/arm/dbclient) && cp /tmp/out-arm/dbclient /out/arm/dbclient \
 && mkdir -p $(dirname /out/arm/dropbearconvert) && cp /tmp/out-arm/dropbearconvert /out/arm/dropbearconvert \
 && mkdir -p $(dirname /out/arm/dropbearkey) && cp /tmp/out-arm/dropbearkey /out/arm/dropbearkey \
 && mkdir -p $(dirname /out/arm/scp) && cp /tmp/out-arm/scp /out/arm/scp \
 && strip "/out/x64/dropbear" "/out/x64/dbclient" "/out/x64/dropbearconvert" "/out/x64/dropbearkey" "/out/x64/scp" "/out/arm/dropbear" "/out/arm/dbclient" "/out/arm/dropbearconvert" "/out/arm/dropbearkey" "/out/arm/scp" \
 && upx -q --best --lzma "/out/x64/dropbear" "/out/x64/dbclient" "/out/x64/dropbearconvert" "/out/x64/dropbearkey" "/out/x64/scp" "/out/arm/dropbear" "/out/arm/dbclient" "/out/arm/dropbearconvert" "/out/arm/dropbearkey" "/out/arm/scp" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
