# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds bit at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/bit build/bit

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/chriswalz/bit.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_bit .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_bit .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/bit) && cp /tmp/x64_bit /out/x64/bit \
 && mkdir -p $(dirname /out/arm/bit) && cp /tmp/arm_bit /out/arm/bit \
 && ( upx -q --best --lzma "/out/x64/bit" "/out/arm/bit" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
