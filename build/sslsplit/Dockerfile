# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds sslsplit at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/sslsplit build/sslsplit

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 cmake libevent-static openssl-libs-static libpcap-dev
RUN git clone --depth 1 https://github.com/droe/sslsplit.git /src && cd /src && REF="${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./configure LDFLAGS='-static'  \
 && make -j$(nproc) \
 && cp sslsplit /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/sslsplit) && cp /tmp/out/sslsplit /out/x64/sslsplit \
 && strip "/out/x64/sslsplit" \
 && ( upx -q --best --lzma "/out/x64/sslsplit" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
