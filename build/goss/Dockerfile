# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds goss at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/goss build/goss

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/goss-org/goss.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_goss ./cmd/goss

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_goss ./cmd/goss

RUN set -ex \
 && mkdir -p $(dirname /out/x64/goss) && cp /tmp/x64_goss /out/x64/goss \
 && mkdir -p $(dirname /out/arm/goss) && cp /tmp/arm_goss /out/arm/goss \
 && strip "/out/x64/goss" "/out/arm/goss" \
 && upx -q --best --lzma "/out/x64/goss" "/out/arm/goss" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
