# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds iodine at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/iodine build/iodine

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 zlib-static zlib-dev pkgconf
RUN git clone --depth 1 https://github.com/yarrick/iodine.git /src && cd /src && REF="v${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN sed -i 's/^#if !defined(ANDROID)/#if 0/' src/common.c
RUN set -ex \
 && mkdir -p /tmp/out \
 && make -C src -j$(nproc) TARGETOS=Linux LDFLAGS="-static -lz $(sh osflags Linux link)" \
 && cp bin/iodine bin/iodined /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/iodine) && cp /tmp/out/iodine /out/x64/iodine \
 && mkdir -p $(dirname /out/x64/iodined) && cp /tmp/out/iodined /out/x64/iodined \
 && for f in "/out/x64/iodine" "/out/x64/iodined"; do file "$f" | grep -q ELF && strip "$f" || true; done \
 && test -n "$(ls "/out/x64/iodine" "/out/x64/iodined" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && for f in "/out/x64/iodine" "/out/x64/iodined"; do file "$f" | grep -q ELF || continue; file "$f" | grep -qE "statically linked|static-pie linked" || { echo "ERROR: $f is dynamically linked"; file "$f"; exit 1; }; done \
 && ( upx -q --best --lzma "/out/x64/iodine" "/out/x64/iodined" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
