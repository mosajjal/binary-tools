# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds superfile at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/superfile build/superfile

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/yorukot/superfile.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_superfile .

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_superfile .

RUN set -ex \
 && mkdir -p $(dirname /out/x64/superfile) && cp /tmp/x64_superfile /out/x64/superfile \
 && mkdir -p $(dirname /out/arm/superfile) && cp /tmp/arm_superfile /out/arm/superfile \
 && ( upx -q --best --lzma "/out/x64/superfile" "/out/arm/superfile" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
