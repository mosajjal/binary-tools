# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds gojq at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/gojq build/gojq

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 https://github.com/itchyny/gojq.git /src && cd /src && REF="v${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_gojq ./cmd/gojq

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_gojq ./cmd/gojq

RUN set -ex \
 && mkdir -p $(dirname /out/x64/gojq) && cp /tmp/x64_gojq /out/x64/gojq \
 && mkdir -p $(dirname /out/arm/gojq) && cp /tmp/arm_gojq /out/arm/gojq \
 && test -n "$(ls "/out/x64/gojq" "/out/arm/gojq" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && ( upx -q --best --lzma "/out/x64/gojq" "/out/arm/gojq" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
