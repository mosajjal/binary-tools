# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds wg at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=1.0.20210914 -t bt/wg build/wg

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2
RUN git clone --depth 1 https://git.zx2c4.com/wireguard-tools /src && cd /src && REF="v${VERSION}" && (git fetch --depth 1 origin tag $REF 2>/dev/null; git checkout $REF 2>/dev/null) || (git fetch --depth 1 origin tag $REF.0 2>/dev/null; git checkout $REF.0 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION} 2>/dev/null; git checkout v${VERSION} 2>/dev/null) || (git fetch --depth 1 origin tag v${VERSION}.0 2>/dev/null; git checkout v${VERSION}.0 2>/dev/null) || (git fetch --depth 1 origin tag ${VERSION} 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || (git fetch --unshallow 2>/dev/null || git fetch --depth 1000 origin 2>/dev/null; git checkout ${VERSION} 2>/dev/null) || true; cd /
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && make -C src -j$(nproc) PLATFORM=linux LDFLAGS=-static wg \
 && cp src/wg /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/wg) && cp /tmp/out/wg /out/x64/wg \
 && strip "/out/x64/wg" || echo 'strip x64 failed (non-ELF?)' \
 && ( upx -q --best --lzma "/out/x64/wg" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
