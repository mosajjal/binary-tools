# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds micro at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/micro build/micro

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/micro-editor/micro.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_micro ./cmd/micro

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_micro ./cmd/micro

RUN set -ex \
 && mkdir -p $(dirname /out/x64/micro) && cp /tmp/x64_micro /out/x64/micro \
 && mkdir -p $(dirname /out/arm/micro) && cp /tmp/arm_micro /out/arm/micro \
 && strip "/out/x64/micro" "/out/arm/micro" \
 && upx -q --best --lzma "/out/x64/micro" "/out/arm/micro" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
