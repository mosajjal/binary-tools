# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds ncdu at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/ncdu build/ncdu

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 ncurses-static ncurses-dev
RUN mkdir -p /src && curl -fsSL --retry 3 --retry-delay 2 "https://dev.yorhel.nl/download/ncdu-${VERSION}.tar.gz" | gunzip -c | tar x -C /src --strip-components=1
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./configure LDFLAGS=-static \
 && make -j$(nproc) \
 && cp ncdu /tmp/out/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/ncdu) && cp /tmp/out/ncdu /out/x64/ncdu \
 && for f in "/out/x64/ncdu"; do file "$f" | grep -q ELF && strip "$f" || true; done \
 && test -n "$(ls "/out/x64/ncdu" 2>/dev/null | head -1)" || { echo "ERROR: no binaries produced"; exit 1; } \
 && ( upx -q --best --lzma "/out/x64/ncdu" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
