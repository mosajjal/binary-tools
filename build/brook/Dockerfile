# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds brook at a given ARG VERSION statically for x64 and ARMv7.
# usage: docker build --build-arg VERSION=SET_ME -t bt/brook build/brook

FROM golang:1.25-alpine AS build
ARG VERSION
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates upx
RUN git clone --depth 1 --branch v${VERSION} https://github.com/txthinking/brook.git /src
WORKDIR /src
RUN set -ex \
 && go build -trimpath -ldflags="-s -w" -o /tmp/x64_brook ./cli/brook

RUN set -ex \
 && GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w" -o /tmp/arm_brook ./cli/brook

RUN set -ex \
 && mkdir -p $(dirname /out/x64/brook) && cp /tmp/x64_brook /out/x64/brook \
 && mkdir -p $(dirname /out/arm/brook) && cp /tmp/arm_brook /out/arm/brook \
 && ( upx -q --best --lzma "/out/x64/brook" "/out/arm/brook" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
