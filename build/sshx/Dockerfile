# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds sshx at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/sshx build/sshx

FROM rust:1-alpine AS build
ARG VERSION
RUN apk add --no-cache protoc
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-C target-feature=+crt-static"
ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABIHF_RUSTFLAGS="-C target-feature=+crt-static"
RUN apk add --no-cache git ca-certificates upx musl-dev perl make
RUN git clone --depth 1 https://github.com/ekzhang/sshx.git /src
WORKDIR /src
ENV PROTOC=/usr/bin/protoc
RUN set -ex \
 && cargo build --release --target x86_64-unknown-linux-musl \
 && cp target/x86_64-unknown-linux-musl/release/sshx /tmp/x64_sshx \
 && cp target/x86_64-unknown-linux-musl/release/sshx-server /tmp/x64_sshx-server

RUN set -ex \
 && mkdir -p $(dirname /out/x64/sshx) && cp /tmp/x64_sshx /out/x64/sshx \
 && mkdir -p $(dirname /out/x64/sshx-server) && cp /tmp/x64_sshx-server /out/x64/sshx-server \
 && strip "/out/x64/sshx" "/out/x64/sshx-server" || echo 'strip x64 failed (non-ELF?)' \
 && ( upx -q --best --lzma "/out/x64/sshx" "/out/x64/sshx-server" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
