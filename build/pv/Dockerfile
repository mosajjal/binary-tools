# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds pv at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/pv build/pv

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 gettext-tiny-dev ncurses-static ncurses-dev
RUN mkdir -p /src && curl -fsSL "https://www.ivarch.com/programs/sources/pv-${VERSION}.tar.gz" | gunzip -c | tar x -C /src --strip-components=1
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./configure --disable-nls LDFLAGS=-static \
 && make -j$(nproc) \
 && cp pv /tmp/out/

# --- ARMv7 cross (musl.cc toolchain) ---
ADD https://github.com/mosajjal/binary-tools/releases/download/toolchain-v1/armtc.tgz /tmp/armtc.tgz
RUN tar -C /opt -zxf /tmp/armtc.tgz
ENV PATH=/opt/arm-linux-musleabihf-cross/bin:$PATH
RUN set -ex \
 && mkdir -p /tmp/out-arm \
 && make distclean || true \
 && ./configure --host=arm-linux-musleabihf --disable-nls LDFLAGS=-static \
 && make -j$(nproc) \
 && cp pv /tmp/out-arm/

RUN set -ex \
 && mkdir -p $(dirname /out/x64/pv) && cp /tmp/out/pv /out/x64/pv \
 && mkdir -p $(dirname /out/arm/pv) && cp /tmp/out-arm/pv /out/arm/pv \
 && strip "/out/x64/pv" "/out/arm/pv" \
 && upx -q --best --lzma "/out/x64/pv" "/out/arm/pv" || echo 'upx failed; shipping unpacked'

FROM alpine:3.20
COPY --from=build /out /out
