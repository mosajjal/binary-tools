# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds nmap at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/nmap build/nmap

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 openssl-dev openssl-libs-static pcre2-dev zlib-static zlib-dev
RUN mkdir -p /src && curl -fsSL "https://nmap.org/dist/nmap-${VERSION}.tar.bz2" | bunzip2 -c | tar x -C /src --strip-components=1
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && ./configure --without-zenmap --without-ndiff --without-nmap-update --without-libssh2 --with-libpcap=included --with-libpcre=included --with-zlib=included --with-openssl=/usr LDFLAGS=-static \
 && make -j$(nproc) \
 && cp nmap /tmp/out/ \
 && cp nping/nping /tmp/out/ 2>/dev/null || cp nping /tmp/out/ 2>/dev/null || true

RUN set -ex \
 && mkdir -p $(dirname /out/x64/nmap) && cp /tmp/out/nmap /out/x64/nmap \
 && mkdir -p $(dirname /out/x64/nping) && cp /tmp/out/nping /out/x64/nping \
 && strip "/out/x64/nmap" "/out/x64/nping" \
 && ( upx -q --best --lzma "/out/x64/nmap" "/out/x64/nping" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
