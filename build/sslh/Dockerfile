# Generated by scripts/gen_dockerfiles.py -- edit recipes there, not here.
# Builds sslh at a given ARG VERSION statically for x64.
# usage: docker build --build-arg VERSION=SET_ME -t bt/sslh build/sslh

FROM alpine:3.20 AS build
ARG VERSION
RUN apk add --no-cache build-base git ca-certificates curl upx linux-headers xz bzip2 pcre2-dev libconfig-dev libev-dev openssl-libs-static
RUN git clone --depth 1 --branch v${VERSION} https://github.com/yrutschle/sslh.git /src
WORKDIR /src
RUN set -ex \
 && mkdir -p /tmp/out \
 && make -j$(nproc) sslh-select CC=gcc LDFLAGS=-static USELIBCONFIG=1 \
 && cp sslh-select /tmp/out/sslh

RUN set -ex \
 && mkdir -p $(dirname /out/x64/sslh) && cp /tmp/out/sslh /out/x64/sslh \
 && strip "/out/x64/sslh" \
 && ( upx -q --best --lzma "/out/x64/sslh" || echo 'upx failed; shipping unpacked' )

FROM alpine:3.20
COPY --from=build /out /out
